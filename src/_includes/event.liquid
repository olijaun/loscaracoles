---
layout: base.liquid
---
{% assign concertDay = eventDate | dateISO %}
{% assign isPast = false %}
{% assign lastDay = endDate | dateISO | default: concertDay %}
{% if lastDay < buildDate %}{% assign isPast = true %}{% endif %}
<main id="inhalt">
  <article>
    <div class="detail-intro">
      <div class="wrap{% if image and image != empty %} event-intro-grid{% endif %}">
        <div>
          {% if isPast %}
            <a class="back-link" href="{{ "/archiv/" | url }}">Zum Veranstaltungsarchiv</a>
          {% else %}
            <a class="back-link" href="{{ "/events/" | url }}">Veranstaltungen</a>
          {% endif %}
          {% if organizer and organizer != empty %}
            <p class="label">{{ organizer | escape }}</p>
          {% endif %}
          <h1>{{ title | escape }}</h1>
          <dl class="event-facts">
            <dt>Datum</dt>
            <dd><time datetime="{{ concertDay }}">{{ eventDate | concertDate }}</time></dd>
            {% if doorsTime and doorsTime != empty %}
              <dt>Türöffnung</dt>
              <dd><time datetime="{{ doorsTime | escape }}">{{ doorsTime | escape }}</time> Uhr</dd>
            {% endif %}
            {% if eventTime and eventTime != empty %}
              <dt>Beginn</dt>
              <dd><time datetime="{{ eventTime | escape }}">{{ eventTime | escape }}</time> Uhr</dd>
            {% endif %}
            {% if lastDay != concertDay %}
              <dt>Ende</dt>
              <dd>
                <time datetime="{{ lastDay }}">{{ lastDay | concertDate }}</time>
                {% if endTime and endTime != empty %}
                  <span class="event-end-time"><time datetime="{{ endTime | escape }}">{{ endTime | escape }}</time> Uhr</span>
                {% endif %}
              </dd>
            {% elsif endTime and endTime != empty %}
              <dt>Ende</dt>
              <dd><time datetime="{{ endTime | escape }}">{{ endTime | escape }}</time> Uhr</dd>
            {% endif %}
            <dt>Ort</dt>
            <dd>
              {{ venue | escape }}
              {% if address and address != empty %}
                <span class="event-address">{{ address | escape }}</span>
              {% endif %}
            </dd>
          </dl>
          {% if ticketUrl and ticketUrl != empty and isPast == false %}
            <p class="event-ticket"><a class="text-link" href="{{ ticketUrl | escape }}">Zum Ticketshop</a></p>
          {% endif %}
        </div>
        {% if image and image != empty %}
          <img class="concert-image" src="{{ image | url | escape }}" alt="{{ imageAlt | default: "" | escape }}">
        {% endif %}
      </div>
    </div>
    <div class="wrap program">
      <div class="concert-body">
        {{ content }}
        {% if ticketUrl and ticketUrl != empty and isPast == false %}
          <p><a class="button copper" href="{{ ticketUrl | escape }}">Zum Ticketshop</a></p>
        {% endif %}
        {% assign mapLatitude = latitude %}
        {% assign mapLongitude = longitude %}
        {% if mapLatitude == nil or mapLongitude == nil or mapLatitude == empty or mapLongitude == empty %}
          {% assign location = address | lookupAddress %}
          {% assign mapLatitude = location.latitude %}
          {% assign mapLongitude = location.longitude %}
        {% endif %}
        {% if mapLatitude and mapLongitude and mapLatitude != empty and mapLongitude != empty %}
          {% assign south = mapLatitude | minus: 0.0018 %}
          {% assign north = mapLatitude | plus: 0.0018 %}
          {% assign west = mapLongitude | minus: 0.003 %}
          {% assign east = mapLongitude | plus: 0.003 %}
          <section class="concert-map" aria-labelledby="anreise">
            <h2 id="anreise">Anreise</h2>
            <div data-event-map>
              <button class="map-link" type="button" hidden>Karte anzeigen</button>
              <p data-map-notice hidden>Beim Laden der Karte wird deine IP-Adresse an OpenStreetMap übermittelt.</p>
              <template>
                <iframe title="OpenStreetMap: {{ venue | escape }}" referrerpolicy="no-referrer"
                  src="https://www.openstreetmap.org/export/embed.html?bbox={{ west }},{{ south }},{{ east }},{{ north }}&amp;layer=mapnik&amp;marker={{ mapLatitude | escape }},{{ mapLongitude | escape }}"></iframe>
              </template>
            </div>
            <script type="module" src="{{ "/assets/event-map.js" | url }}"></script>
            <p><a href="https://www.openstreetmap.org/?mlat={{ mapLatitude | escape }}&amp;mlon={{ mapLongitude | escape }}#map=17/{{ mapLatitude | escape }}/{{ mapLongitude | escape }}">Grössere Karte auf OpenStreetMap</a>
              · <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap-Mitwirkende</a></p>
          </section>
        {% elsif address and address != empty %}
          <section class="concert-map" aria-labelledby="anreise">
            <h2 id="anreise">Anreise</h2>
            <p><a href="https://www.openstreetmap.org/search?query={{ address | url_encode }}">Adresse auf OpenStreetMap suchen</a></p>
          </section>
        {% endif %}
      </div>
    </div>
  </article>
</main>
