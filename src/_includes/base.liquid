<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% capture eventDescription %}{% if eventDate %}{{ title }} am {{ eventDate | concertDate }}{% if venue %} · {{ venue }}{% endif %}. Informationen zur Veranstaltung im Kalender von Los Caracoles.{% endif %}{% endcapture %}
  {% assign pageDescription = description | default: eventDescription | default: "Flamenco-Veranstaltungen und Vereinsleben in Bern." %}
  {% capture pageTitle %}{{ title }} · Los Caracoles{% endcapture %}
  <meta name="description" content="{{ pageDescription | escape }}">
  <meta name="theme-color" content="#301713">
  <title>{{ pageTitle | escape }}</title>
  {% if noindex or seo.staging %}
    <meta name="robots" content="noindex">
  {% endif %}
  {% if seo.origin != empty %}
    {% assign publicUrl = page.url | url | prepend: seo.origin %}
    {% assign shareImage = image | default: "/assets/guitarra.jpg" %}
    {% unless shareImage contains "://" %}
      {% assign shareImage = shareImage | url | prepend: seo.origin %}
    {% endunless %}
    <link rel="canonical" href="{{ publicUrl | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Peña Flamenca Los Caracoles">
    <meta property="og:locale" content="de_CH">
    <meta property="og:title" content="{{ pageTitle | escape }}">
    <meta property="og:description" content="{{ pageDescription | escape }}">
    <meta property="og:url" content="{{ publicUrl | escape }}">
    <meta property="og:image" content="{{ shareImage | escape }}">
    {% if imageAlt %}
      <meta property="og:image:alt" content="{{ imageAlt | escape }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
  {% endif %}
  <link rel="stylesheet" href="{{ "/assets/style.css" | url }}?v=membership-form">
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <header class="header">
    <div class="wrap top">
      <a class="brand" href="{{ "/" | url }}" aria-label="Los Caracoles, Startseite">
        <img src="{{ "/assets/logo69.png" | url }}" alt="" width="56" height="56">
        <span class="brand-text"><span>LOS CARACOLES</span><small>PEÑA FLAMENCA · BERN</small></span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="{{ "/events/" | url }}"{% if section == "concerts" %} aria-current="page"{% endif %}>Veranstaltungen</a>
        <a href="{{ "/verein/" | url }}"{% if section == "club" %} aria-current="page"{% endif %}>Verein</a>
        <a href="{{ "/links/" | url }}"{% if section == "links" %} aria-current="page"{% endif %}>Links</a>
        <a href="{{ "/" | url }}#mitmachen">Mitmachen</a>
      </nav>
      <nav class="header-social" aria-label="Soziale Medien">
        <a href="https://www.facebook.com/people/Pe%C3%B1a-Flamenca-Los-Caracoles/100057343754399/" aria-label="Los Caracoles auf Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M14 21v-8h2.7l.4-3H14V8c0-.9.3-1.5 1.6-1.5h1.7V3.8c-.3-.1-1.3-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3V10H8v3h2.6v8z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/loscaracolesbern" aria-label="Los Caracoles auf Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/>
          </svg>
        </a>
      </nav>
    </div>
  </header>
{{ content }}
  <footer>
    <div class="wrap foot">
      <span>Peña Flamenca Los Caracoles · Bern</span>
      <div>
        <a href="mailto:vorstand@loscaracoles.ch">Kontakt</a>
        <a href="{{ "/impressum/" | url }}">Impressum</a>
        <a href="{{ "/datenschutz/" | url }}">Datenschutz</a>
      </div>
    </div>
  </footer>
</body>
</html>
