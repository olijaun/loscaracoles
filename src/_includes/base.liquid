<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description | default: "Flamenco-Konzerte und Vereinsleben in Bern." | escape }}">
  <meta name="theme-color" content="#301713">
  <title>{{ title | escape }} · Los Caracoles</title>
  <link rel="stylesheet" href="{{ "/assets/style.css" | url }}">
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <header class="header">
    <div class="wrap top">
      <a class="brand" href="{{ "/" | url }}" aria-label="Los Caracoles, Startseite">
        <img src="{{ "/assets/logo69.png" | url }}" alt="" width="56" height="56">
        <span class="brand-text"><span>LOS CARACOLES</span><small>PEÑA FLAMENCA · BERN</small></span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="{{ "/konzerte/" | url }}"{% if section == "concerts" %} aria-current="page"{% endif %}>Konzerte</a>
        <a href="{{ "/verein/" | url }}"{% if section == "club" %} aria-current="page"{% endif %}>Verein</a>
        <a href="{{ "/" | url }}#mitmachen">Mitmachen</a>
      </nav>
    </div>
  </header>
{{ content }}
  <footer>
    <div class="wrap foot">
      <span>Peña Flamenca Los Caracoles · Bern</span>
      <div><a href="mailto:vorstand@loscaracoles.ch">Kontakt</a><a href="https://www.loscaracoles.ch/impressum/">Impressum</a></div>
    </div>
  </footer>
</body>
</html>
