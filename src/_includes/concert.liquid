---
layout: base.liquid
---
{% assign concertDay = eventDate | dateISO %}
{% assign isPast = false %}
{% if concertDay < buildDate %}{% assign isPast = true %}{% endif %}
<main id="inhalt">
  <article>
    <div class="detail-intro">
      <div class="wrap">
        {% if isPast %}
          <a class="back-link" href="{{ "/archiv/" | url }}">Zum Konzertarchiv</a>
        {% else %}
          <a class="back-link" href="{{ "/konzerte/" | url }}">Kommende Konzerte</a>
        {% endif %}
        <h1>{{ title | escape }}</h1>
        <p class="detail-lead"><time datetime="{{ concertDay }}">{{ eventDate | concertDate }}</time>{% if eventTime and eventTime != empty %} · {{ eventTime | escape }} Uhr{% endif %}{% if doorsTime and doorsTime != empty %} · Türöffnung {{ doorsTime | escape }} Uhr{% endif %} · {{ venue | escape }}{% if address and address != empty %}<br>{{ address | escape }}{% endif %}</p>
      </div>
    </div>
    <div class="wrap program">
      <div class="concert-body">
        {% if image and image != empty %}
          <img class="concert-image" src="{{ image | url | escape }}" alt="{{ imageAlt | default: "" | escape }}">
        {% endif %}
        {{ content }}
        {% if latitude and longitude and latitude != empty and longitude != empty %}
          {% assign south = latitude | minus: 0.0018 %}
          {% assign north = latitude | plus: 0.0018 %}
          {% assign west = longitude | minus: 0.003 %}
          {% assign east = longitude | plus: 0.003 %}
          <section class="concert-map" aria-labelledby="anreise">
            <h2 id="anreise">Anreise</h2>
            <iframe title="OpenStreetMap: {{ venue | escape }}" loading="lazy"
              src="https://www.openstreetmap.org/export/embed.html?bbox={{ west }},{{ south }},{{ east }},{{ north }}&amp;layer=mapnik&amp;marker={{ latitude | escape }},{{ longitude | escape }}"></iframe>
            <p><a href="https://www.openstreetmap.org/?mlat={{ latitude | escape }}&amp;mlon={{ longitude | escape }}#map=17/{{ latitude | escape }}/{{ longitude | escape }}">Grössere Karte auf OpenStreetMap</a>
              · <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap-Mitwirkende</a></p>
          </section>
        {% endif %}
        {% if ticketUrl and ticketUrl != empty and isPast == false %}
          <p><a class="button copper" href="{{ ticketUrl | escape }}">Tickets</a></p>
        {% endif %}
      </div>
    </div>
  </article>
</main>
