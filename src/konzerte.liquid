---
layout: base.liquid
title: Kommende Veranstaltungen
section: concerts
permalink: /konzerte/index.html
---
<main id="inhalt">
  <section class="detail-intro">
    <div class="wrap">
      <h1>Kommende Veranstaltungen</h1>
    </div>
  </section>
  <section class="program">
    <div class="wrap">
      {% assign events = collections.concerts | upcoming: buildDate %}
      {% include "upcoming.liquid" %}
      {% if events.size > 0 %}
        <a class="text-link archive-link" href="{{ "/archiv/" | url }}">Vergangene Konzerte</a>
      {% endif %}
    </div>
  </section>
</main>
