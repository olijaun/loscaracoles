---
layout: base.liquid
title: Veranstaltungsarchiv
description: Vergangene Flamenco-Veranstaltungen von Los Caracoles in Bern. Stöbere in Konzertdaten, Spielorten und Besetzungen.
section: concerts
permalink: /archiv/index.html
---
<main id="inhalt">
  <section class="detail-intro">
    <div class="wrap">
      <a class="back-link" href="{{ "/events/" | url }}">Veranstaltungen</a>
      <h1>Veranstaltungsarchiv</h1>
    </div>
  </section>
  <section class="program">
    <div class="wrap">
      {% assign events = collections.concerts | past: buildDate %}
      {% if events.size > 0 %}
        {% include "event-list.liquid" %}
      {% else %}
        <p>Zurzeit sind keine Veranstaltungen im Archiv.</p>
      {% endif %}
    </div>
  </section>
</main>
